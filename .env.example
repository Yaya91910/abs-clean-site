# Copier en .env (jamais commité) ou définir ces variables dans l'hébergeur.
# Aucune valeur réelle ici : clés et numéros sont fournis par le gérant.

ConnectionStrings__Default=
Email__ApiKey=
Email__From=
Email__GerantTo=
Sms__ApiKey=
Sms__Sender=
Sms__GerantNumero=
Cors__AllowedOrigin=

# Adresse publique du site (liens de parrainage, QR codes, lien de validation du gérant)
Site__Url=

# Hébergement : migrations au démarrage, en-têtes du proxy (IP réelle du client, HTTPS)
Database__MigrerAuDemarrage=
Proxy__EntetesTransferees=

# Coordonnées imprimées sur le devis PDF (À FOURNIR par le gérant)
Entreprise__Siret=
Entreprise__Adresse=
Entreprise__Telephone=
Entreprise__Email=

# Sans Email__ApiKey / Sms__ApiKey : mode test, e-mails, PDF et SMS sont écrits dans ce dossier au lieu d'être envoyés
Envoi__Test__Dossier=
